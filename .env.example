# Lokale Entwicklung: nach .env kopieren und Werte setzen.
# Wird von "docker compose -f docker-compose.dev.yml" automatisch geladen.
DB_USER=mauerseglerhilfe
DB_PASSWORD=

KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

